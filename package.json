{
  "name": "drowned-frontier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @frontier/server\" \"npm run dev -w @frontier/web\"",
    "build": "npm run typecheck && npm run build -w @frontier/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx apps/server/src/index.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "verify": "npm test && npm run build && npm run test:e2e && npm run test:mechanics",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"tests/*.ts\" tsconfig.json package.json",
    "benchmark": "tsx tests/benchmark.ts",
    "test:mechanics": "tsx tests/mechanics-e2e.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.14.0",
    "concurrently": "9.1.2",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@upstash/redis": "1.41.0"
  }
}
